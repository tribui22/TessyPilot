$testobject {
	$stubfunctions {
		void ucDrv_ConfigureFCC(const ucDrv_Cfg_ClkSelfTst_t * arg1) '''
		'''
		boolean_t ucDrv_FCCDone() '''
			int mapped_tc = (TS_CURRENT_TESTCASE - 1) % 3 + 1; if (mapped_tc == 1) { static int call_count = 0; if (call_count++ == 0) return 0; return 1; } return 0;
		'''
		u32 ucDrv_ReadFCC() '''
			int mapped_tc = (TS_CURRENT_TESTCASE - 1) % 3 + 1; if (mapped_tc == 1) { return 2; } else if (mapped_tc == 2) { return 0; } else if (mapped_tc == 3) { return 1; } return 0;
		'''
		void ucDrv_SetFCCPeriod(const ucDrv_Cfg_ClkSelfTst_t * arg1) '''
		'''
		void ucDrv_StartFCC() '''
		'''
		void ucDrv_UnlockRegister() '''
		'''
	}

	$testcase 1 {
		$name "ucDrv_CfgClockSelfTst. Test case 01"
		$specification """
			[Test Goal]
				Verify that ucDrv_CfgClockSelfTst correctly takes the FALSE branch: loop executes once, frequency greater than upper bound (OvFrq)
			[Precondition]
				Set input variables so that the following condition evaluates to FALSE: loop executes once, frequency greater than upper bound (OvFrq)
			[Test Description]
				Execute ucDrv_CfgClockSelfTst() targeting: loop executes once, frequency greater than upper bound (OvFrq). Expected outcome: if(ucDrv_Cfg_FccFrequency_u32 > ucDrv_Cfg_FccFreqTempUp_u32); loop entered once.
			[Expected Result]
				Output match expected results which specified in test steps
				- Condition evaluates to FALSE (Target: if(ucDrv_Cfg_FccFrequency_u32 > ucDrv_Cfg_FccFreqTempUp_u32); loop entered once)
				- Correct branch statements execute (C0 + C1 coverage met)
				- Function completes without errors or unexpected side-effects
			[Post Condition]
				None
			[Test Type]
				Tessy
			[Priority]
				Medium
		"""
		$description """
			loop executes once, frequency greater than upper bound (OvFrq)
		"""

		$teststep 1.1 {
			$name "loop executes once, frequency greater than upper bound (OvFrq)"
			$stubfunctions {
				boolean_t ucDrv_FCCDone() '''
					static int call_count = 0;
    if (call_count++ == 0) return 0;
    return 1;
				'''
				u32 ucDrv_ReadFCC() '''
					return 2;
				'''
			}
			$inputs {
				config_ptr = target_config_ptr[0]
				target_config_ptr[0].fccTriggerLevel_en = 0
				target_config_ptr[0].fccTriggerSource_en = 0
				target_config_ptr[0].fccMeasureSource_en = 0
				target_config_ptr[0].fccCountingPeriods_u8 = 31
				target_config_ptr[0].expectedFrequency_en = 1000
				target_config_ptr[0].tolerance_u8 = 10
				target_config_ptr[0].testTimeOut = 10
			}
			$outputs {
				return = ucDrv_ClkSelfTst_OvFrq
			}
			$calltrace {
				*** Ignore Call Trace ***
			}
		}
	}
